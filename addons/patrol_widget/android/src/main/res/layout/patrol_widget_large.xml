<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/PatrolWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/patrol_widget_bg">

<LinearLayout
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="SPD Patrols"
        android:textColor="#FFC9A96E"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/patrol_none"
        android:textColor="#FFE8E0D0"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/name0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE8E0D0"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/back0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patrol_back"
                android:textColor="#FFFFD27A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE8E0D0"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/reward0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF9A9488"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/name1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE8E0D0"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/back1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patrol_back"
                android:textColor="#FFFFD27A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE8E0D0"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/reward1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF9A9488"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/name2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE8E0D0"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/back2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patrol_back"
                android:textColor="#FFFFD27A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE8E0D0"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/reward2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF9A9488"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/name3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFE8E0D0"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/back3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patrol_back"
                android:textColor="#FFFFD27A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <Chronometer
                android:id="@+id/timer3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE8E0D0"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/reward3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF9A9488"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
