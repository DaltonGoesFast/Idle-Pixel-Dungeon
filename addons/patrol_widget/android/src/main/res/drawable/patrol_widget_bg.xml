<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 launchers do not force system_app_widget_background_radius.
     8dp corners and a 3dp-inset stroke stay inside any host mask. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1B1712" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#FFC9A96E" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
