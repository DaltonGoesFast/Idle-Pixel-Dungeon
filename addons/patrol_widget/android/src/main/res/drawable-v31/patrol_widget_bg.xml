<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ clips the widget to system_app_widget_background_radius.
     The fill uses that radius. The gold stroke is inset so the launcher mask
     and resize frame cannot cut its corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1B1712" />
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#FFC9A96E" />
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
        </shape>
    </item>
</layer-list>
