config_version=5

[application]

config/name="SPD Tactics"
config/version="0.16.1"
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DB="*res://scripts/autoload/db.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=968
window/size/viewport_height=2376
window/size/window_width_override=484
window/size/window_height_override=1188
window/handheld/orientation=6
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[gui]

theme/custom_font="res://assets/fonts/pixel_font.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
