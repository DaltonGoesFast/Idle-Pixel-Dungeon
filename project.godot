; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Idle PD"
config/version="0.50.4"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/windows_native_icon="res://assets/branding/idle_pd.ico"

[autoload]

DB="*res://scripts/autoload/db.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Updater="*res://scripts/autoload/updater.gd"
Telemetry="*res://scripts/autoload/telemetry.gd"
PatrolBridge="*res://scripts/platform/patrol_bridge.gd"
LiveLayout="*res://scripts/autoload/live_layout.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/apk_install/plugin.cfg", "res://addons/patrol_widget/plugin.cfg")

[display]

window/size/viewport_width=968
window/size/viewport_height=2376
window/size/window_width_override=484
window/size/window_height_override=1188
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]

theme/custom_font="res://assets/fonts/pixel_font.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
